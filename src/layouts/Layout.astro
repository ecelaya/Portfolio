---
import '../styles/global.css';
import Nav from '../components/Nav.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Data science consultant at Management Solutions building AI-driven risk analytics for European banks. MSc in Big Data & AI (UCM) and Business Consulting (ICADE). Portfolio of ML, statistical modelling and data engineering projects.',
} = Astro.props;

const siteUrl = 'https://www.ecelaya.com';
const ogImage = `${siteUrl}/og-image.png`;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Eloy Celaya López',
  url: siteUrl,
  jobTitle: 'Data Science Consultant',
  worksFor: {
    '@type': 'Organization',
    name: 'Management Solutions',
  },
  alumniOf: [
    { '@type': 'Organization', name: 'Universidad Carlos III de Madrid' },
    { '@type': 'Organization', name: 'Universidad Complutense de Madrid' },
  ],
  knowsAbout: [
    'Data Science',
    'Machine Learning',
    'Risk Analytics',
    'Python',
    'Power BI',
    'PySpark',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} is:inline />
  </head>
  <body>
    <Nav />
    <slot />
  </body>

  <script>
    // Scroll reveal — Intersection Observer
    // Skipped entirely when user prefers reduced motion (CSS handles static state)
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const observer = new IntersectionObserver(
        (entries) => {
          let delay = 0;
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const el = entry.target as HTMLElement;
              setTimeout(() => {
                el.classList.add('is-revealed');
              }, delay);
              delay += 70; // stagger simultaneous entries
              observer.unobserve(el);
            }
          });
        },
        { threshold: 0.08, rootMargin: '0px 0px -24px 0px' }
      );

      document
        .querySelectorAll('[data-reveal]')
        .forEach((el) => observer.observe(el));
    }
  </script>
</html>
