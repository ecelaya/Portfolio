---

<header class="nav" data-nav>
  <div class="nav-inner">
    <a href="/" class="nav-logo" aria-label="Eloy Celaya López — Home">EC</a>
    <nav aria-label="Main navigation">
      <ul class="nav-links" role="list">
        <li><a href="#projects">Projects</a></li>
        <li><a href="#experience">Experience</a></li>
        <li><a href="#education">Education</a></li>
        <li><a href="#contact" class="nav-cta">Contact</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom: 1px solid transparent;
    box-shadow: none;
    transition:
      background 320ms ease,
      border-color 320ms ease,
      box-shadow 320ms ease,
      backdrop-filter 320ms ease;
  }

  .nav[data-scrolled] {
    background: rgba(11, 14, 20, 0.9);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom-color: rgba(77, 143, 172, 0.08);
    box-shadow: 0 1px 12px rgba(0, 0, 0, 0.3);
  }

  .nav-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-logo {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: 0.06em;
    transition: color 0.18s ease;
  }

  .nav-logo:hover {
    color: var(--accent);
  }

  .nav-links {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-links a {
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--text-secondary);
    letter-spacing: 0.01em;
    transition: color 200ms ease;
  }

  .nav-links a:hover {
    color: var(--text-primary);
  }

  .nav-links a.active {
    color: var(--accent);
  }

  .nav-cta {
    color: var(--accent) !important;
    border: 1px solid rgba(77, 143, 172, 0.3);
    padding: 0.375rem 1rem;
    border-radius: 4px;
    transition:
      background 0.18s ease,
      border-color 0.18s ease !important;
  }

  .nav-cta:hover {
    background: rgba(77, 143, 172, 0.1) !important;
    border-color: var(--accent) !important;
  }

  @media (max-width: 600px) {
    .nav-inner {
      padding: 0 1.25rem;
    }

    .nav-links {
      gap: 1.25rem;
    }

    .nav-links a {
      font-size: 0.825rem;
    }

    .nav-cta {
      padding: 0.35rem 0.75rem !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav { transition: none; }
  }
</style>

<script>
  const nav = document.querySelector('[data-nav]');
  if (nav) {
    const update = () => {
      if (window.scrollY > 40) {
        nav.setAttribute('data-scrolled', '');
      } else {
        nav.removeAttribute('data-scrolled');
      }
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
  }

  const navLinks = new Map();
  document.querySelectorAll('.nav-links a[href^="#"]').forEach((link) => {
    const id = link.getAttribute('href')?.slice(1);
    if (id) navLinks.set(id, link);
  });

  const visibleAreas = new Map();

  const setActiveLink = () => {
    let activeId = null;
    let maxArea = 0;
    visibleAreas.forEach((area, id) => {
      if (area > maxArea) {
        maxArea = area;
        activeId = id;
      }
    });

    navLinks.forEach((link, id) => {
      link.classList.toggle('active', id === activeId);
    });
  };

  if (navLinks.size && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const id = entry.target.id;
          if (entry.isIntersecting) {
            visibleAreas.set(id, entry.intersectionRect.width * entry.intersectionRect.height);
          } else {
            visibleAreas.delete(id);
          }
        });
        setActiveLink();
      },
      { threshold: 0.3 }
    );

    navLinks.forEach((_, id) => {
      const section = document.getElementById(id);
      if (section) observer.observe(section);
    });
  }
</script>
