---
const certs = [
  {
    name: "Snowflake University Platform Skills Badge",
    issuer: "Snowflake",
    date: "Aug 2026",
    badge: null,
    url: "https://achieve.snowflake.com/d2b1ec21-b8bc-472d-8a32-928ec7586802#acc.t26TgFRY",
  },
  {
    name: "Microsoft Power BI Data Analyst",
    issuer: "Microsoft",
    date: "Dec 2025",
    badge: null,
    url: "https://coursera.org/share/de38dd905f13b17474d2c7a6a55127d9",
  },
  {
    name: "IELTS (C1 Advanced)",
    issuer: "British Council",
    date: "Sep 2023",
    badge: null,
    downloadUrl: "/IELTS_Certificate_Eloy_Celaya.pdf",
  },
];
---

<section id="certifications" class="section">
  <div class="container">
    <header class="section-header">
      <span class="section-tag">Certifications</span>
      <h2 class="section-title">Credentials</h2>
    </header>

    <div class="cert-list" data-reveal>
      {certs.map((cert) => (
        <div class="cert-row">
          <div class="cert-main">
            <span class="cert-name">{cert.name}</span>
            <div class="cert-meta">
              <span class="cert-issuer">{cert.issuer}</span>
              {cert.badge && <span class="cert-badge">{cert.badge}</span>}
              {cert.url && (
                <a
                  href={cert.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="cert-action"
                  aria-label={`View ${cert.name} certificate (opens in new tab)`}
                >
                  View Certificate
                  <span class="cert-action-icon" aria-hidden="true">↗</span>
                </a>
              )}
              {cert.downloadUrl && (
                <a
                  href={cert.downloadUrl}
                  download
                  class="cert-action"
                  aria-label={`Download ${cert.name} certificate (PDF)`}
                >
                  Download Certificate
                  <span class="cert-action-icon" aria-hidden="true">↓</span>
                </a>
              )}
            </div>
          </div>
          <span class="cert-date">{cert.date}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section {
    padding: 6rem 1.5rem;
    border-top: 1px solid rgba(139, 147, 161, 0.08);
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .section-header {
    margin-bottom: 2.5rem;
  }

  .section-tag {
    display: block;
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }

  .section-title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 500;
    color: var(--text-primary);
  }

  /* ── Cert list ── */
  .cert-list {
    display: flex;
    flex-direction: column;
    max-width: 800px;
  }

  .cert-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding: 1.125rem 0;
    border-bottom: 1px solid rgba(139, 147, 161, 0.08);
  }

  .cert-row:first-child {
    border-top: 1px solid rgba(139, 147, 161, 0.08);
  }

  .cert-main {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .cert-name {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .cert-meta {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex-wrap: wrap;
  }

  .cert-issuer {
    font-size: 0.825rem;
    color: var(--accent);
  }

  .cert-badge {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--accent);
    background: rgba(77, 143, 172, 0.08);
    border: 1px solid rgba(77, 143, 172, 0.22);
    padding: 0.18rem 0.55rem;
    border-radius: 3px;
  }

  .cert-action {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--accent);
    background: rgba(77, 143, 172, 0.08);
    border: 1px solid rgba(77, 143, 172, 0.22);
    padding: 0.3rem 0.65rem;
    border-radius: 4px;
    transition:
      background 0.18s ease,
      border-color 0.18s ease;
  }

  .cert-action:hover {
    background: rgba(77, 143, 172, 0.16);
    border-color: var(--accent);
  }

  .cert-action-icon {
    font-size: 1em;
    line-height: 1;
  }

  .cert-date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
    white-space: nowrap;
    flex-shrink: 0;
  }

  @media (max-width: 600px) {
    .section {
      padding: 4rem 1.25rem;
    }

    .cert-row {
      align-items: flex-start;
    }
  }
</style>
