---
---

<section id="education" class="section">
  <div class="container">
    <header class="section-header">
      <span class="section-tag">Education</span>
      <h2 class="section-title">Academic background</h2>
    </header>

    <!-- ── CURRENT ───────────────────────────────── -->
    <div class="edu-group">
      <div class="edu-group-header">
        <span class="group-label group-label--current">Current</span>
        <p class="group-note">
          Pursuing both in parallel to cover the full spectrum &mdash; from
          technical AI&thinsp;/&thinsp;ML foundations to the business and
          consulting side of data science.
        </p>
      </div>

      <div class="edu-cards edu-cards--stack">
        <article class="edu-card" data-reveal>
          <div class="card-top">
            <span class="card-date">2026 – 2027</span>
          </div>
          <h3 class="card-degree">MSc Big Data, Data Science and AI</h3>
          <span class="card-school">Universidad Complutense de Madrid</span>
          <span class="card-location">Madrid, Spain</span>
          <ul class="card-courses">
            <li>Machine Learning</li>
            <li>Deep Learning</li>
            <li>Big Data</li>
            <li>Computer Vision</li>
            <li>NLP</li>
            <li>Python</li>
            <li>SQL</li>
          </ul>
        </article>

        <article class="edu-card" data-reveal>
          <div class="card-top">
            <span class="card-date">2026 – 2027</span>
          </div>
          <h3 class="card-degree">MSc Business Consulting &amp; Data Science</h3>
          <span class="card-school">ICADE Business School · Universidad Pontificia Comillas</span>
          <span class="card-location">Madrid, Spain</span>
          <ul class="card-courses">
            <li>Fundamentos de DS y Análisis de datos en el sector financiero</li>
            <li>Diseño y modelización de bases de datos y SQL</li>
            <li>Introducción a SAS y a R</li>
            <li>Introducción a la consultoría</li>
            <li>Project finance y corporate finance</li>
            <li>Regulación del sector financiero</li>
          </ul>
        </article>
      </div>
    </div>

    <!-- ── COMPLETED ──────────────────────────────── -->
    <div class="edu-group">
      <div class="edu-group-header">
        <span class="group-label group-label--completed">Completed</span>
      </div>

      <div class="edu-cards edu-cards--stack">
        <article class="edu-card" data-reveal>
          <div class="card-top">
            <span class="card-date">2024 – 2025</span>
            <div class="card-badges">
              <span class="badge badge--accent">Dean&rsquo;s List</span>
              <span class="badge">GPA 3.91 / 4</span>
            </div>
          </div>
          <h3 class="card-degree">BS Statistics and Business</h3>
          <span class="card-school">Grand Valley State University</span>
          <span class="card-location">Michigan, US &middot; Exchange student</span>
          <ul class="card-courses">
            <li>Data Analysis Tools &amp; Techniques (Honours)</li>
            <li>Applied Regression Analysis</li>
            <li>Computing and Graphics with R</li>
            <li>Concepts of Database Systems</li>
          </ul>
        </article>

        <article class="edu-card" data-reveal>
          <div class="card-top">
            <span class="card-date">2021 – 2026</span>
            <div class="card-badges">
              <span class="badge">Course delegate</span>
              <span class="badge">GPA 7.6 / 10</span>
            </div>
          </div>
          <h3 class="card-degree">BS Statistics and Business</h3>
          <span class="card-school">Universidad Carlos III de Madrid</span>
          <span class="card-location">Madrid, Spain</span>
          <ul class="card-courses">
            <li>Multivariate Analysis</li>
            <li>Advanced Regression Methods</li>
            <li>Statistical Inference Methods II</li>
            <li>Advanced Spreadsheets (Excel)</li>
          </ul>
        </article>

        <article class="edu-card" data-reveal>
          <div class="card-top">
            <span class="card-date">July 2025</span>
          </div>
          <h3 class="card-degree">Consultant Professional Accelerator</h3>
          <span class="card-school">Timestamp España</span>
          <span class="card-location">Madrid, Spain · Bootcamp</span>
        </article>

        <article class="edu-card edu-card--minor" data-reveal>
          <div class="card-top">
            <span class="card-date">2011 – 2024</span>
          </div>
          <h3 class="card-degree">Professional Music Degree — Guitar &amp; Composition</h3>
          <span class="card-school">CPM Adolfo Salazar</span>
          <span class="card-location">Madrid, Spain</span>
        </article>
      </div>
    </div>

  </div>
</section>

<style>
  .section {
    padding: 6rem 1.5rem;
    border-top: 1px solid rgba(139, 147, 161, 0.08);
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
  }

  /* ── Section header ── */
  .section-header {
    margin-bottom: 3rem;
  }

  .section-tag {
    display: block;
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }

  .section-title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 500;
    color: var(--text-primary);
  }

  /* ── Groups ── */
  .edu-group {
    margin-bottom: 2.5rem;
  }

  .edu-group-header {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .group-label {
    font-family: var(--font-display);
    font-size: 0.67rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.2rem 0.6rem;
    border-radius: 3px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .group-label--current {
    color: var(--accent);
    background: rgba(77, 143, 172, 0.1);
    border: 1px solid rgba(77, 143, 172, 0.22);
  }

  .group-label--completed {
    color: var(--text-secondary);
    background: rgba(139, 147, 161, 0.08);
    border: 1px solid rgba(139, 147, 161, 0.16);
  }

  .group-note {
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 62ch;
  }

  /* ── Card grid variants ── */
  .edu-cards {
    display: grid;
    gap: 1rem;
  }

  .edu-cards--stack {
    grid-template-columns: 1fr;
  }

  /* ── Unified card ── */
  .edu-card {
    background: var(--bg-surface);
    border: 1px solid rgba(77, 143, 172, 0.22);
    border-radius: 8px;
    padding: 1.5rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    box-shadow: 0 1px 6px rgba(0, 0, 0, 0.3);
    transition:
      opacity 450ms ease-out,
      transform 450ms ease-out,
      border-color 200ms ease-out,
      box-shadow 200ms ease-out;
  }

  .edu-card:hover {
    transform: translateY(-2px);
    border-color: rgba(77, 143, 172, 0.38);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.28);
  }

  .edu-card--minor {
    border-color: rgba(139, 147, 161, 0.14);
    box-shadow: none;
  }

  .edu-card--minor .card-degree {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-secondary);
  }

  .edu-card--minor .card-school {
    color: var(--accent);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .card-date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
    flex-shrink: 0;
  }

  .card-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    justify-content: flex-end;
  }

  .badge {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--text-secondary);
    background: rgba(139, 147, 161, 0.08);
    border: 1px solid rgba(139, 147, 161, 0.14);
    padding: 0.18rem 0.55rem;
    border-radius: 3px;
    letter-spacing: 0.03em;
    white-space: nowrap;
  }

  .badge--accent {
    color: var(--accent);
    background: rgba(77, 143, 172, 0.08);
    border-color: rgba(77, 143, 172, 0.22);
  }

  .card-degree {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .card-school {
    font-size: 0.875rem;
    color: var(--accent);
  }

  .card-location {
    font-size: 0.8rem;
    color: var(--text-secondary);
    opacity: 0.65;
  }

  /* ── Courses pills ── */
  .card-courses {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(139, 147, 161, 0.08);
  }

  .card-courses li {
    font-family: var(--font-mono);
    font-size: 0.63rem;
    color: var(--text-secondary);
    opacity: 0.65;
    background: rgba(139, 147, 161, 0.06);
    border: 1px solid rgba(139, 147, 161, 0.1);
    padding: 0.15rem 0.5rem;
    border-radius: 2px;
    letter-spacing: 0.02em;
  }

  /* ── Responsive ── */
  @media (max-width: 700px) {
    .card-top {
      flex-direction: column;
      gap: 0.5rem;
    }

    .card-badges {
      justify-content: flex-start;
    }
  }

  @media (max-width: 600px) {
    .section {
      padding: 4rem 1.25rem;
    }

    .edu-group-header {
      flex-direction: column;
      gap: 0.625rem;
    }
  }
</style>
