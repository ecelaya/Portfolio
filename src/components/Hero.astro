  <div class="hero-inner">
    <div class="hero-content">
      <div class="hero-identity">
        <img
          src="/avatar.jpg"
          alt="Eloy Celaya López"
          class="hero-avatar"
          width="104"
          height="104"
        />
        <span class="hero-name">Eloy Celaya López</span>
      </div>

      <h1 class="hero-headline">
        Building AI-driven risk analytics<br />for European banks.
      </h1>
      <p class="hero-sub">
        Data science consultant at Management Solutions, pursuing parallel MSc
        degrees in AI&thinsp;/&thinsp;Data Science (UCM) and Business
        Consulting (ICADE). Based in Madrid.
      </p>
      <div class="hero-ctas">
        <a href="#projects" class="btn btn-primary">View Projects</a>
        <a href="#" class="btn btn-secondary" aria-label="Download CV (coming soon)">
          Download CV
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: 88vh;
  }

  .hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 1100px;
    width: 100%;
    margin: 0 auto;
    padding: 6vh 1.5rem 5vh;
    min-height: 88vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hero-content {
    max-width: 620px;
  }

  .hero-identity {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 2.25rem;
  }

  .hero-avatar {
    width: 104px;
    height: 104px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 8%;
    border: 3px solid var(--bg-base);
    box-shadow: 0 0 0 2px rgba(77, 143, 172, 0.4);
    flex-shrink: 0;
  }

  .hero-name {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.5vw, 1.75rem);
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .hero-headline {
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
  }

  .hero-sub {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 46ch;
    margin-bottom: 2.25rem;
  }

  .hero-ctas {
    display: flex;
    gap: 0.875rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.625rem 1.5rem;
    border-radius: 4px;
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 500;
    transition:
      background 0.18s ease,
      border-color 0.18s ease,
      color 0.18s ease;
    cursor: pointer;
    border: 1px solid transparent;
  }

  .btn-primary {
    background: var(--accent);
    color: #0b0e14;
    border-color: var(--accent);
  }

  .btn-primary:hover {
    background: #5ea3c0;
    border-color: #5ea3c0;
  }

  .btn-secondary {
    background: transparent;
    color: var(--text-primary);
    border-color: rgba(232, 234, 237, 0.2);
  }

  .btn-secondary:hover {
    border-color: rgba(232, 234, 237, 0.45);
    background: rgba(232, 234, 237, 0.04);
  }

  @media (max-width: 768px) {
    .hero-inner {
      min-height: auto;
      padding: 4rem 1.25rem 5rem;
    }

    .hero-headline {
      font-size: clamp(1.875rem, 8vw, 2.5rem);
    }

    .hero-sub {
      max-width: 100%;
    }
  }

  @media (max-width: 480px) {
    .hero-ctas {
      flex-direction: column;
    }

    .btn {
      justify-content: center;
    }
  }
</style>
