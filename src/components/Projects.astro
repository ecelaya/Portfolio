---
---

<section id="projects" class="section">
  <div class="container">
    <header class="section-header">
      <span class="section-tag">Projects</span>
      <h2 class="section-title">Selected work</h2>
    </header>

    <div class="projects-placeholder" data-reveal>
      <p class="placeholder-text">
        Case studies are being written up &mdash; check back soon.
      </p>
    </div>
  </div>
</section>

<style>
  .section {
    padding: 6rem 1.5rem;
    border-top: 1px solid rgba(139, 147, 161, 0.08);
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .section-header {
    margin-bottom: 2.5rem;
  }

  .section-tag {
    display: block;
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }

  .section-title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 500;
    color: var(--text-primary);
  }

  .projects-placeholder {
    border: 1px dashed rgba(139, 147, 161, 0.2);
    border-radius: 8px;
    padding: 3rem 1.75rem;
    text-align: center;
  }

  .placeholder-text {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  @media (max-width: 600px) {
    .section {
      padding: 4rem 1.25rem;
    }
  }
</style>
