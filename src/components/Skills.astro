---
const categories = [
  {
    label: "Languages & Programming",
    skills: [
      { name: "Python", detail: "pandas · scikit-learn · XGBoost · statsmodels" },
      "SQL",
      "R",
      "SAS",
    ],
  },
  {
    label: "Databases",
    skills: ["MySQL", "MongoDB"],
  },
  {
    label: "Data Engineering",
    skills: ["PySpark", "Databricks", "Snowflake", "ETL"],
  },
  {
    label: "Reporting & BI",
    skills: ["Power BI", "Tableau", "Excel"],
  },
  {
    label: "Version Control",
    skills: ["Git"],
  },
  {
    label: "Spoken Languages",
    skills: ["Spanish (Native)", "English (C1 — IELTS certified)", "French (Intermediate)"],
  },
];
---

<section id="skills" class="section">
  <div class="container">
    <header class="section-header">
      <span class="section-tag">Skills</span>
      <h2 class="section-title">What I work with</h2>
    </header>

    <div class="skills-grid">
      {categories.map((cat) => (
        <div class="skill-category" data-reveal>
          <span class="category-label">{cat.label}</span>
          <div class="skill-chips">
            {cat.skills.map((s) =>
              typeof s === "string" ? (
                <span class="skill-chip">{s}</span>
              ) : (
                <span class="skill-chip skill-chip--detailed">
                  <span class="chip-name">{s.name}</span>
                  <span class="chip-detail">{s.detail}</span>
                </span>
              )
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section {
    padding: 6rem 1.5rem;
    border-top: 1px solid rgba(139, 147, 161, 0.08);
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .section-header {
    margin-bottom: 3rem;
  }

  .section-tag {
    display: block;
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }

  .section-title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 500;
    color: var(--text-primary);
  }

  /* ── Grid of categories ── */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.25rem 4rem;
  }

  .skill-category {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .category-label {
    font-family: var(--font-display);
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  /* ── Chips ── */
  .skill-chips {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.625rem;
  }

  .skill-chip {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-secondary);
    background: rgba(77, 143, 172, 0.07);
    border: 1px solid rgba(77, 143, 172, 0.14);
    padding: 0.45rem 0.9rem;
    border-radius: 4px;
    letter-spacing: 0.03em;
  }

  /* ── Python chip: name + library detail as one unit ── */
  .skill-chip--detailed {
    flex-basis: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.2rem;
    padding: 0.4rem 0.9rem 0.5rem;
  }

  .chip-name {
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  .chip-detail {
    font-size: 0.66rem;
    color: var(--text-secondary);
    opacity: 0.6;
    letter-spacing: 0.02em;
  }

  @media (max-width: 640px) {
    .skills-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }

  @media (max-width: 600px) {
    .section {
      padding: 4rem 1.25rem;
    }
  }
</style>
